    IR.Then{IR.Ensure{IR.Lt{IR.Lit{0n}, IR.Var{308n}}, "InsufficientInputAmount()", []},
    IR.Bind{IR.Mul{IR.Var{277n}, IR.Lit{1000n}}, 310n,
