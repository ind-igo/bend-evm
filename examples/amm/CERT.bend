    IR.Bind{IR.Sub{IR.Var{310n}, IR.Var{311n}}, 312n,
    IR.Bind{IR.Mul{IR.Var{278n}, IR.Lit{1000n}}, 313n,
    IR.Bind{IR.Mul{IR.Var{307n}, IR.Lit{3n}}, 314n,
    IR.Bind{IR.Sub{IR.Var{313n}, IR.Var{314n}}, 315n,
    IR.Bind{IR.Mul{IR.Var{312n}, IR.Var{315n}}, 316n,
    IR.Bind{IR.Mul{IR.Var{223n}, IR.Var{224n}}, 317n,
    IR.Bind{IR.Mul{IR.Var{317n}, IR.Lit{1000n}}, 318n,
    IR.Bind{IR.Mul{IR.Var{318n}, IR.Lit{1000n}}, 319n,
    IR.Then{IR.Ensure{IR.Not{IR.Lt{IR.Var{316n}, IR.Var{319n}}}, "K()", []},
    IR.Then{IR.SStore{IR.Plain{IR.Lit{5n}}, IR.Var{277n}},
    IR.Then{IR.SStore{IR.Plain{IR.Lit{6n}}, IR.Var{278n}},
    IR.Then{IR.Log{"Sync(uint256,uint256)", [], [IR.Var{277n}, IR.Var{278n}]},
    IR.Then{IR.Log{"Swap(address,address,uint256,uint256,uint256,uint256)", [IR.Var{220n}, IR.Var{2n}], [IR.Var{306n}, IR.Var{307n}, IR.Var{0n}, IR.Var{1n}]},
    IR.Finish{IR.SStore{IR.Temp{IR.Lit{0n}}, IR.Lit{0n}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}},
    IR.Then{IR.Invoke{IR.Var{2n}, "uniswapV2Call(address,uint256,uint256,bytes)", [IR.Var{220n}, IR.Var{0n}, IR.Var{1n}, IR.Bytes{3n}]},
    IR.Bind{IR.Self{}, 378n,
