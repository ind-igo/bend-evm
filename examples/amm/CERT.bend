    IR.Bind{IR.View{IR.Var{275n}, "balanceOf(address)", [IR.Var{274n}]}, 277n,
    IR.Bind{IR.View{IR.Var{276n}, "balanceOf(address)", [IR.Var{274n}]}, 278n,
    IR.Bind{IR.Sub{IR.Var{223n}, IR.Var{0n}}, 302n,
