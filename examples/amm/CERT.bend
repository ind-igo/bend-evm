    IR.Finish{IR.SStore{IR.Temp{IR.Lit{0n}}, IR.Lit{0n}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}}

law swap:
  for +p0: Nat
  for +p1: Nat
  for +p2: Nat
  for +p3: Evm.Bytes
  {IR.call(ir.swap(), IR.Stops{}, [IR.Binding{0n, p0}, IR.Binding{1n, p1}, IR.Binding{2n, p2}, IR.Blob{3n, p3}]) == Program.swap(p0, p1, p2, p3) : Evm.Contract(Unit)}

def swap(p0, p1, p2, p3):
  {==}

def ir.getReserves() -> IR.Cmd:
  IR.Bind{IR.SLoad{IR.Plain{IR.Lit{5n}}}, 0n,
    IR.Bind{IR.SLoad{IR.Plain{IR.Lit{6n}}}, 1n,
    IR.Give{"Reserves(uint256,uint256)", [IR.Var{0n}, IR.Var{1n}]}}}

law getReserves:
  {IR.call(ir.getReserves(), IR.Gives{}, []) == Program.getReserves() : Evm.Contract(Evm.Values)}

def getReserves():
  {==}

def entry.table() -> List<&2, Calls.Entry>:
  [Calls.Entry{ir.decimals(), IR.Returns{}, []},
  Calls.Entry{ir.token0(), IR.Returns{}, []},
  Calls.Entry{ir.token1(), IR.Returns{}, []},
  Calls.Entry{ir.reserve0(), IR.Returns{}, []},
  Calls.Entry{ir.reserve1(), IR.Returns{}, []},
  Calls.Entry{ir.totalSupply(), IR.Returns{}, []},
  Calls.Entry{ir.balanceOf(), IR.Returns{}, [Calls.Word{}]},
  Calls.Entry{ir.allowance(), IR.Returns{}, [Calls.Word{}, Calls.Word{}]},
  Calls.Entry{ir.approve(), IR.Returns{}, [Calls.Word{}, Calls.Word{}]},
  Calls.Entry{ir.transfer(), IR.Returns{}, [Calls.Word{}, Calls.Word{}]},
  Calls.Entry{ir.transferFrom(), IR.Returns{}, [Calls.Word{}, Calls.Word{}, Calls.Word{}]},
  Calls.Entry{ir.sync(), IR.Stops{}, []},
  Calls.Entry{ir.mint(), IR.Returns{}, [Calls.Word{}]},
  Calls.Entry{ir.burn(), IR.Stops{}, [Calls.Word{}]},
  Calls.Entry{ir.swap(), IR.Stops{}, [Calls.Word{}, Calls.Word{}, Calls.Word{}, Calls.Dynamic{}]},
  Calls.Entry{ir.getReserves(), IR.Gives{}, []}]
