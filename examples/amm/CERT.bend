    IR.Bind{IR.Math{Evm.Sub{}, [IR.Var{61n}, IR.Var{86n}]}, 88n,
    IR.Bind{IR.Math{Evm.Sub{}, [IR.Var{62n}, IR.Var{87n}]}, 89n,
    IR.Bind{IR.Select{IR.Lt{IR.Var{86n}, IR.Var{61n}}, IR.Var{88n}, IR.Lit{0n}}, 90n,
